{
  "name": "orbit",
  "version": "1.2.0",
  "description": "Station alternative - Modern web app hub",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.js",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run icons && npm run build && electron-builder",
    "release": "npm run icons && npm run build && electron-builder --linux AppImage --publish always",
    "release:ci": "npm run icons && npm run build && electron-builder --publish always"
  },
  "keywords": [
    "electron",
    "station",
    "workspace",
    "productivity"
  ],
  "author": {
    "name": "Orbit",
    "email": "contact@orbit.app"
  },
  "homepage": "https://orbit.app",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldts-experimental": "^7.4.10",
    "tweetnacl": "^1.0.3",
    "yauzl": "^2.10.0",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.orbit.app",
    "productName": "Orbit",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "clarco-mada-digital",
        "repo": "orbit"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/lib/shortcuts.js",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "dist/icons/**",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "desktop": {
        "entry": {
          "Name": "Orbit",
          "Comment": "Hub applicatif — vos apps web dans une seule fenêtre",
          "StartupWMClass": "orbit"
        }
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    }
  }
}
