{
  "manifest_version": 3,
  "name": "Color Picker",
  "version": "1.2.0",
  "description": "Pipette de couleur intégrée : clic sur l'extension dans la barre d'Orbit (ou Alt+C), survolez pour voir la couleur, cliquez pour copier. Ne touche pas au menu contextuel.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [],
  "host_permissions": [],
  "orbit": {
    "launcher": "colorPicker",
    "minOrbitVersion": "1.21.5"
  }
}
