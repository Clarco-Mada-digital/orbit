node_modules
dist
dist-electron
# Extensions optionnelles : seules les sources livrées avec Orbit sont suivies.
electron/extensions/*
!electron/extensions/orbit-phone/
!electron/extensions/orbit-phone/**
!electron/extensions/text-snippets/
!electron/extensions/text-snippets/**
!electron/extensions/web-clipper/
!electron/extensions/web-clipper/**
extensions-src/*

# Extensions distribuables (ZIPs) — dossier dédié, suivi en git
# (pas dans dist/ car dist est ignoré, donc dossier séparé pour les ZIPs)
*.local
.DS_Store
.vscode
.idea
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.swp
*.swo
*~
.cache
.argus/
.parcel-cache
.turbo
coverage
.nyc_output
.env
.env.*
!.env.example

# Fichiers de test / scratch
*.mjs
*.cjs
!vite.config.mjs
# …mais les preloads Electron (.cjs) DOIVENT être suivis
!electron/*.cjs
# …et les scripts d'outillage (export des extensions, etc.)
!scripts/*.cjs
# dist/extensions/ est suivi en git pour les ZIPs d'extensions distribuables
# Ces ZIPs sont partagés avec les utilisateurs pour installation manuelle
# Mais ils ne sont PAS inclus dans le build de l'application (release)
