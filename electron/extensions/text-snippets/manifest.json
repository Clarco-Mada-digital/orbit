{
  "manifest_version": 3,
  "name": "Text Snippets",
  "version": "1.2.0",
  "description": "Abréviations extensibles : tapez ;email, ;addr, ;sig… dans un champ et elles se remplacent immédiatement. Configurable (⚙️).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": []
}
